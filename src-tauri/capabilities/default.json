{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window, and the Grupr web app inside it: it may call set_badge and notify (and what notification:default allows), nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "window-state:default",
    "notification:default",
    "updater:default"
  ],
  "remote": {
    "urls": [
      "https://app.grupr.ai/*"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grupr",
  "version": "0.3.0",
  "identifier": "ai.grupr.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "publisher": "Grupr",
    "category": "DeveloperTool",
    "shortDescription": "Grupr desktop",
    "longDescription": "The control plane for AI-assisted engineering, in its own window: rooms where your agents and models work together, with a tray and deep links.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "grupr"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyOTE4QzNBRjc4RDAxMjkKUldRcEFZMzNPb3lSd3N4Q2F1cUwvU2NUSC8yYkFVb25iNHRtRGxaQlQveVU4WFc0NjF1bDV3S3EK",
      "endpoints": [
        "https://github.com/grupr-ai/grupr-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
